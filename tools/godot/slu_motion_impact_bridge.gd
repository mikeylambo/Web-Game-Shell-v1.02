class_name SLUMotionImpactBridge
extends Node

signal motion_marker(marker_id: String, kind: String, recipe_id: String, payload: Dictionary)
signal impact_requested(recipe_id: String, payload: Dictionary)

@export var animation_player_path: NodePath
var animation_player: AnimationPlayer
var manifest: Dictionary = {}
var impact_recipes: Dictionary = {}

func _ready() -> void:
	if animation_player_path != NodePath(""):
		animation_player = get_node_or_null(animation_player_path) as AnimationPlayer

func load_manifest_file(path: String) -> bool:
	if not FileAccess.file_exists(path):
		push_error("SLU manifest not found: %s" % path)
		return false
	var file := FileAccess.open(path, FileAccess.READ)
	var parsed = JSON.parse_string(file.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("Invalid SLU manifest JSON")
		return false
	manifest = parsed
	_rebuild_recipe_index()
	return true

func _rebuild_recipe_index() -> void:
	impact_recipes.clear()
	for recipe in manifest.get("impacts", []):
		if typeof(recipe) == TYPE_DICTIONARY and recipe.has("id"):
			impact_recipes[str(recipe.id)] = recipe

# AnimationPlayer method tracks generated by SLU call this method.
func _slu_motion_marker(marker_id: String, kind: String, recipe_id: String = "", payload: Dictionary = {}) -> void:
	motion_marker.emit(marker_id, kind, recipe_id, payload)
	if recipe_id != "":
		impact_requested.emit(recipe_id, payload)

func get_impact_recipe(recipe_id: String) -> Dictionary:
	return impact_recipes.get(recipe_id, {})

func play_clip(animation_name: StringName, custom_blend: float = -1.0, custom_speed: float = 1.0) -> void:
	if animation_player == null:
		push_warning("SLU MotionImpactBridge has no AnimationPlayer")
		return
	if not animation_player.has_animation(animation_name):
		push_warning("SLU animation not found: %s" % animation_name)
		return
	animation_player.play(animation_name, custom_blend, custom_speed)
